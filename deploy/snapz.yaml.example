# Copy to deploy/snapz.yaml (gitignored). Layered over snapz-common.yaml via SNAPZ_CONFIG.
# Holds the secrets: chmod 600.
# Give snapz its own database user, never root:
#   CREATE DATABASE snapz CHARACTER SET utf8mb4;
#   CREATE USER 'snapz'@'%' IDENTIFIED BY '<long random>';
#   GRANT ALL ON snapz.* TO 'snapz'@'%';
data_source:
  host: host.docker.internal
  database: snapz
  username: snapz
  password: CHANGEME

snapz:
  blob_dir: /data/blobs
  public_url: https://snapz.example.net
  oidc:
    issuer: https://id.example.net
    client_id: CHANGEME
    client_secret: CHANGEME
    # Register this callback URL with the provider: <public_url>/auth/callback
    allowed_emails: [you@example.net]
    allowed_groups: []
    # Members of these groups at the provider are admins (vault/token management, purge, sink
    # endpoints, misk's /_admin/ dashboard). Empty = everyone on the allowlist is.
    admin_groups: [snapz-admins]
    # Other client ids whose issuer-signed JWTs are accepted as bearer tokens (client_id always is):
    # bearer_audiences: []
  # Optional: let "invite" create the person's account at Pocket ID and add them to the group that may
  # sign in. Without it an invitation only shares the vault and you make the account yourself.
  # pocket_id:
  #   url: http://127.0.0.1:1411        # Pocket ID's API as this server reaches it
  #   api_key: CHANGEME                 # Pocket ID's STATIC_API_KEY: an admin key, guard it like one
  #   users_group: snapz-users          # = one of allowed_groups above
  # Optional break-glass token for first boot / when SSO is down. Remove once a script token exists.
  # With an https public_url the server refuses to start on a token shorter than 32 chars
  # (openssl rand -hex 24).
  # bootstrap_tokens:
  #   - { token: CHANGEME-long-random, principal: bootstrap }
