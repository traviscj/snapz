# nginx in front of snapz on a public host. Copy, replace snapz.example.net, add your certificate.
# In the http{} block (e.g. /etc/nginx/conf.d/snapz-limits.conf):
#   limit_req_zone $binary_remote_addr zone=snapz_auth:10m rate=10r/m;
#   limit_req_zone $binary_remote_addr zone=snapz_api:10m  rate=20r/s;
server {
    listen 443 ssl http2;
    server_name snapz.example.net;
    # ssl_certificate / ssl_certificate_key: certbot fills these in.

    client_max_body_size 64m;          # = snapz.max_upload_bytes; nginx refuses bigger bodies before the app reads them
    client_body_timeout 120s;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_http_version 1.1;
    proxy_request_buffering off;       # stream uploads through instead of spooling them to disk first

    # Service internals: not for the internet.
    location ~ ^/_(status|readiness|liveness|admin) { return 404; }

    # Guessing tokens and codes is slow here.
    location /auth/ {
        limit_req zone=snapz_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8788;
    }

    location / {
        limit_req zone=snapz_api burst=200 nodelay;
        proxy_pass http://127.0.0.1:8788;
    }
}
server {
    listen 80;
    server_name snapz.example.net;
    return 301 https://$host$request_uri;
}
